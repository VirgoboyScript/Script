-- Variabel Kontrol
local isRunning = false

-- Fungsi Eksekusi Teleport ke Index Tertentu
local function teleportTo(index)
    if index < 1 or index > #waypoints then return false end
    
    local pos = waypoints[index]
    character = player.Character or player.CharacterAdded:Wait()
    humanoidRootPart = character:WaitForChild("HumanoidRootPart")
    
    humanoidRootPart.CFrame = CFrame.new(pos)
    CpInput.Text = tostring(index)
    return true
end

-- Fungsi Utama Loop Teleport
task.spawn(function()
    while true do
        if isRunning then
            local startCp = tonumber(CpInput.Text) or 1
            if startCp < 1 or startCp > #waypoints then startCp = 1 end
            
            local loopCount = 0
            while isRunning do
                loopCount = loopCount + 1
                
                for i = startCp, #waypoints do
                    if not isRunning then break end
                    
                    -- Update CP input box
                    CpInput.Text = tostring(i)
                    local customDelay = tonumber(DelayInput.Text) or 10
                    
                    -- Lakukan Teleport
                    if not teleportTo(i) then break end
                    
                    -- Countdown Delay
                    local countdown = customDelay
                    while countdown > 0 and isRunning do
                        local currentDelayLimit = tonumber(DelayInput.Text) or 10
                        if countdown > currentDelayLimit then
                            countdown = currentDelayLimit
                        end
                        
                        StatusLabel.Text = string.format("[Put. %d] TP %d/%d (Next: %ds)", loopCount, i, #waypoints, math.ceil(countdown))
                        task.wait(1)
                        countdown = countdown - 1
                    end
                end
                
                -- Reset startCp ke 1 untuk putaran berikutnya
                startCp = 1
                
                -- Setelah selesai melewati semua waypoint, eksekusi Event
                if isRunning then
                    StatusLabel.Text = "[Put. " .. loopCount .. "] Firing Event..."
                    local success, err = pcall(function()
                        ReplicatedStorage:WaitForChild("CPEvents"):WaitForChild("ResetToBC"):FireServer()
                    end)
                    
                    if not success then
                        warn("Gagal FireServer: " .. tostring(err))
                    end
                    
                    task.wait(2)
                end
            end
        end
        task.wait(0.1)
    end
end)

-- Tombol Prev
PrevBtn.MouseButton1Click:Connect(function()
    if isRunning then return end -- Jangan ubah manual saat running
    local currentCp = tonumber(CpInput.Text) or 1
    local targetCp = math.clamp(currentCp - 1, 1, #waypoints)
    teleportTo(targetCp)
    StatusLabel.Text = "Moved to CP: " .. targetCp
end)

-- Tombol Next
NextBtn.MouseButton1Click:Connect(function()
    if isRunning then return end
    local currentCp = tonumber(CpInput.Text) or 1
    local targetCp = math.clamp(currentCp + 1, 1, #waypoints)
    teleportTo(targetCp)
    StatusLabel.Text = "Moved to CP: " .. targetCp
end)

-- Event Tombol Toggle
ToggleBtn.MouseButton1Click:Connect(function()
    isRunning = not isRunning
    if isRunning then
        ToggleBtn.Text = "STOP AUTO TP"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(170, 0, 0)
        PrevBtn.Active = false
        NextBtn.Active = false
    else
        ToggleBtn.Text = "START AUTO TP"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        PrevBtn.Active = true
        NextBtn.Active = true
        StatusLabel.Text = "Status: Dihentikan"
    end
end)

