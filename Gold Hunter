local function refreshAutoBtnVisual(isHover)
	if autoPlayEnabled then
		autoBtn.BackgroundColor3 = isHover and AUTO_ON_HOVER or AUTO_ON_NORMAL
		autoBtn.Text = "AUTO PLAY : ON"
		autoBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	else
		autoBtn.BackgroundColor3 = isHover and AUTO_OFF_HOVER or AUTO_OFF_NORMAL
		autoBtn.Text = "AUTO PLAY : OFF"
		autoBtn.TextColor3 = Color3.fromRGB(220, 195, 255)
	end
end

