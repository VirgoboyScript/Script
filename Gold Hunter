local function makePosKey(cf)
	local p = cf.Position
	return string.format("%.0f_%.0f_%.0f", p.X, p.Y, p.Z)
end

local function resetRecordedReveals()
	table.clear(RecordedReveals)
	table.clear(SeenRevealKeys)
end

local function addUniqueReveals(rawBeams, maxLimit)
	local limit = maxLimit or MAX_REVEALS
	local addedCount = 0
	for _, entry in ipairs(rawBeams) do
		if #RecordedReveals >= limit then
			break
		end
		local key = entry.key or makePosKey(entry.cframe)
		if not SeenRevealKeys[key] then
			SeenRevealKeys[key] = true
			table.insert(RecordedReveals, {
				instance = entry.instance,
				cframe = entry.cframe,
				key = key,
			})
			addedCount += 1
		end
	end
	return addedCount
end

local function isActive(token)
	return AutoRunning and (token == RunToken)
end

local function getRootPart()
	local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
	return char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 10)
end

local function getPivotCFrame(obj)
	if not obj or not obj.Parent then
		return nil
	end
	if obj:IsA("BasePart") then
		return obj.CFrame
	elseif obj:IsA("Attachment") then
		return obj.WorldCFrame
	elseif obj:IsA("Model") then
		local ok, cf = pcall(function()
			return obj:GetPivot()
		end)
		if ok and typeof(cf) == "CFrame" then
			return cf
		end
		if obj.PrimaryPart then
			return obj.PrimaryPart.CFrame
		end
		local part = obj:FindFirstChildWhichIsA("BasePart", true)
		if part then
			return part.CFrame
		end
	else
		local part = obj:FindFirstChildWhichIsA("BasePart", true)
		if part then
			return part.CFrame
		end
	end
	return nil
end

local function teleportTo(cf)
	if not cf then return end
	local hrp = getRootPart()
	if hrp then
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
		hrp.CFrame = cf * CFrame.new(0, 3, 0)
	end
end

local function firePrompt(prompt)
	if not prompt or not prompt.Parent or not prompt:IsA("ProximityPrompt") then
		return false
	end
	local okFire = false
	if typeof(fireproximityprompt) == "function" then
		okFire = pcall(function()
			fireproximityprompt(prompt)
		end)
	end
	if not okFire then
		pcall(function()
			prompt:InputHoldBegin()
			task.wait(math.max(prompt.HoldDuration, 0.05))
			prompt:InputHoldEnd()
		end)
	end
	return true
end

local function findPromptIn(container, preferredName)
	if not container then return nil end
	if preferredName then
		local direct = container:FindFirstChild(preferredName, true)
		if direct and direct:IsA("ProximityPrompt") then
			return direct
		end
	end
	return container:FindFirstChildWhichIsA("ProximityPrompt", true)
end

local function getScanObjects()
	local scanner = workspace:FindFirstChild("[WGC Integration] Scanner")
	if not scanner then return nil, nil end
	local att = scanner:FindFirstChild("Attachment")
	local scanPrompt = findPromptIn(att, "@SCAN_PROMPT") or findPromptIn(scanner, "@SCAN_PROMPT")
	return scanner, scanPrompt
end

local function getPortalObjects()
	local portal
	for _, child in ipairs(workspace:GetChildren()) do
		if child.Name == "Portal" and child:FindFirstChild("Emitter") then
			portal = child
			break
		end
	end

	if not portal then
		portal = workspace:FindFirstChild("Portal")
	end

	if not portal then
		return nil, nil
	end

	local emitter = portal:FindFirstChild("Emitter")
	local portalPrompt = findPromptIn(emitter, "@PROMPT")
		or findPromptIn(portal, "@PROMPT")
		or findPromptIn(emitter)
		or findPromptIn(portal)

	return emitter or portal, portalPrompt
end

local function getSmelterObjects()
	local interactable = workspace:FindFirstChild("Interactable")
	local smelter = interactable and interactable:FindFirstChild("Smelter") or workspace:FindFirstChild("Smelter", true)
	if not smelter then return nil, nil end
	local att = smelter:FindFirstChild("Attachment")
	local prompt = findPromptIn(att, "@PROMPT") or findPromptIn(smelter, "@PROMPT")
	return smelter, prompt
end

local function deliverToSmelter()
	onStatusChange("Delivering...", "Deliver")
	local smelter, prompt = getSmelterObjects()
	if not smelter and not prompt then
		onStatusChange("Smelter not found", "Deliver")
		return false
	end
	local targetCF = (prompt and (getPivotCFrame(prompt.Parent) or getPivotCFrame(prompt))) or getPivotCFrame(smelter)
	if targetCF then
		teleportTo(targetCF)
		task.wait(0.2)
	end
	if prompt then
		firePrompt(prompt)
		onStatusChange("Delivered", "Deliver")
		return true
	else
		onStatusChange("Smelt prompt not found", "Deliver")
		return false
	end
end

local function getWorkspaceByName(name)
	local items = {}
	for _, child in ipairs(workspace:GetChildren()) do
		if child.Name == name then
			table.insert(items, child)
		end
	end
	return items
end

local function collectCurrentReveals()
	local beams = getWorkspaceByName("Location Beam")
	local list = {}
	for _, beam in ipairs(beams) do
		local cf = getPivotCFrame(beam)
		if cf then
			table.insert(list, {
				instance = beam,
				cframe = cf,
				key = makePosKey(cf),
			})
		end
	end
	return list
end

local function getDigPrompt(digSpot)
	if not digSpot or not digSpot.Parent then return nil end
	local part = digSpot:FindFirstChild("Part")
	if part then
		local p = part:FindFirstChildWhichIsA("ProximityPrompt", true)
		if p and p.Enabled then return p end
	end
	for _, desc in ipairs(digSpot:GetDescendants()) do
		if desc:IsA("ProximityPrompt") and desc.Enabled then
			return desc
		end
	end
	return nil
end

local function isSpotStillClaimable(digSpot, trackedPrompt)
	if not digSpot or digSpot.Parent == nil then
		return false
	end
	local currentPrompt = getDigPrompt(digSpot)
	if trackedPrompt then
		if trackedPrompt.Parent == nil or not trackedPrompt.Enabled then
			if not currentPrompt then
				return false
			end
		end
	end
	return true
end

local function pickNextDigSpot(failedSpots)
	local digSpots = getWorkspaceByName("Dig Spot")
	for _, spot in ipairs(digSpots) do
		if spot and spot.Parent ~= nil and not failedSpots[spot] then
			return spot
		end
	end
	return nil
end

-- Fokus 1 item saja: teleport 1x ke item, trigger prompt, lalu tunggu sampai item benar-benar terambil/hilang
local function focusSingleDigSpot(token, targetDig, itemIndex, totalTarget)
	if not targetDig or targetDig.Parent == nil then
		return false
	end

	local digCF = getPivotCFrame(targetDig)
	if not digCF then
		return false
	end

	-- Teleport 1 kali saja ke posisi item yang sedang difokuskan
	onStatusChange(string.format("Focus item %d/%d (TP 1x)...", itemIndex, totalTarget), "Dig")
	teleportTo(digCF)
	task.wait(0.25)

	local activePrompt = getDigPrompt(targetDig)
	if activePrompt and activePrompt.Parent and activePrompt.Enabled then
		firePrompt(activePrompt)
	end

	local lastReFire = os.clock()
	local startFocusClock = os.clock()

	-- Tunggu sampai item terambil (hilang dari workspace atau prompt tidak lagi aktif)
	while isActive(token) and isSpotStillClaimable(targetDig, activePrompt) do
		onStatusChange(string.format("Waiting item %d/%d...", itemIndex, totalTarget), "Dig")

		local latestPrompt = getDigPrompt(targetDig)
		if latestPrompt and latestPrompt.Parent and latestPrompt.Enabled then
			activePrompt = latestPrompt
			if (os.clock() - lastReFire) >= 1.1 then
				firePrompt(latestPrompt)
				lastReFire = os.clock()
			end
		else
			task.wait(0.25)
			if not targetDig or targetDig.Parent == nil or not getDigPrompt(targetDig) then
				break
			end
		end

		if (os.clock() - startFocusClock) > 25 then
			break
		end

		task.wait(0.15)
	end

	local claimed = (targetDig == nil or targetDig.Parent == nil)

	-- Delay 5 detik sebelum teleport ke dig spot berikutnya
	local delayStart = os.clock()
	while isActive(token) and (os.clock() - delayStart) < 5 do
		local rem = math.ceil(5 - (os.clock() - delayStart))
		onStatusChange(string.format("Next dig in %ds...", rem), "Delay Dig")
		task.wait(0.2)
	end

	return claimed
end

-- Proses 1 per 1 sampai maksimal MAX_REVEALS (10 item) per sesi
local function processDigSpots(token)
	local failedSpots = {}
	local claimedOrProcessedCount = 0

	while isActive(token) and claimedOrProcessedCount < MAX_REVEALS do
		local targetDig = pickNextDigSpot(failedSpots)
		if not targetDig then
			break
		end

		local nextNumber = claimedOrProcessedCount + 1
		local beforeClock = os.clock()
		focusSingleDigSpot(token, targetDig, nextNumber, MAX_REVEALS)

		claimedOrProcessedCount += 1

		if targetDig and targetDig.Parent ~= nil and (os.clock() - beforeClock) > 29 then
			failedSpots[targetDig] = true
		end
	end
end

local function queueAutoExecOnTeleport()
	if QueuedForTeleport then
		return true
	end

	local qot = queue_on_teleport
		or (queueonteleport)
		or (syn and syn.queue_on_teleport)
		or (fluxus and fluxus.queue_on_teleport)

	if typeof(qot) ~= "function" then
		warn("[Gold Hunters] queue_on_teleport tidak didukung di executor ini.")
		return false
	end

	local payload = string.format([[
		if not game:IsLoaded() then
			game.Loaded:Wait()
		end
		local Players = game:GetService("Players")
		local lp = Players.LocalPlayer or Players.PlayerAdded:Wait()
		local char = lp.Character or lp.CharacterAdded:Wait()
		if not char:FindFirstChild("HumanoidRootPart") then
			char:WaitForChild("HumanoidRootPart")
		end
		task.wait(2)
		local ok, src = pcall(function()
			return game:HttpGet(%q)
		end)
		if ok and type(src) == "string" and #src > 0 then
			local fn, loadErr = loadstring(src)
			if fn then
				fn()
			else
				warn("[Gold Hunters] Loadstring error:", loadErr)
			end
		else
			warn("[Gold Hunters] HttpGet failed:", src)
		end
	]], SCRIPT_URL)

	local ok, err = pcall(function()
		qot(payload)
	end)

	if ok then
		QueuedForTeleport = true
		return true
	else
		warn("[Gold Hunters] Gagal mengantrekan queue_on_teleport:", err)
		return false
	end
end

local function teleportToTargetPlace()
	onStatusChange("Teleporting to game...", "Teleport To Game")
	queueAutoExecOnTeleport()

	--// 「 Credits to Remote Detector 」
	local ok, err = pcall(function()
		TeleportService:Teleport(TARGET_PLACE_ID)
	end)
	if not ok then
		QueuedForTeleport = false
		onStatusChange("TP Error: " .. tostring(err), "Teleport To Game")
		return
	end

	task.delay(6, function()
		if game.PlaceId ~= TARGET_PLACE_ID then
			QueuedForTeleport = false
		end
	end)
end

local function rejoinServer()
	onStatusChange("Rejoining server...", "Rejoin")
	queueAutoExecOnTeleport()

	local placeId = game.PlaceId
	local jobId = game.JobId

	local ok, err = pcall(function()
		if jobId and jobId ~= "" then
			TeleportService:TeleportToPlaceInstance(placeId, jobId, LocalPlayer)
		else
			TeleportService:Teleport(placeId, LocalPlayer)
		end
	end)

	if not ok then
		QueuedForTeleport = false
		onStatusChange("Rejoin Error: " .. tostring(err), "Rejoin")
	end
end

local function runAutoPlayCycle(token)
	resetRecordedReveals()

	onStatusChange("Scanning...", "Scan")
	local _, scanPrompt = getScanObjects()
	if not scanPrompt then
		onStatusChange("Scan not found, delivering...", "Deliver")
		deliverToSmelter()
		task.wait(0.5)
		if isActive(token) then
			onStatusChange("Waiting 18s...", "Wait")
			local waitStart = os.clock()
			while isActive(token) do
				local remaining = 18 - (os.clock() - waitStart)
				if remaining <= 0 then break end
				onStatusChange(string.format("Waiting %ds...", math.floor(remaining)), "Wait")
				task.wait(0.5)
			end
			if isActive(token) then
				teleportToTargetPlace()
				task.wait(2)
			end
		end
		return
	end

	local promptCF = getPivotCFrame(scanPrompt.Parent) or getPivotCFrame(scanPrompt)
	if promptCF then
		teleportTo(promptCF)
		task.wait(0.2)
	end
	firePrompt(scanPrompt)

	onStatusChange("Waiting...", "Reveal")
	local revealWaitStart = os.clock()
	repeat
		if not isActive(token) then return end
		local current = collectCurrentReveals()
		if #current > 0 then
			onStatusChange("Recording...", "Record")
			addUniqueReveals(current, MAX_REVEALS)
			if #RecordedReveals >= MAX_REVEALS then
				break
			end
		end
		task.wait(0.15)
	until (os.clock() - revealWaitStart) > 8

	if #RecordedReveals > 0 then
		onStatusChange("Waiting...", "Hide Reveal")
		local vanishStart = os.clock()
		repeat
			if not isActive(token) then return end
			if #RecordedReveals < MAX_REVEALS then
				local latest = collectCurrentReveals()
				if #latest > 0 then
					addUniqueReveals(latest, MAX_REVEALS)
				end
			end
			local masihAda = 0
			for _, item in ipairs(RecordedReveals) do
				if item.instance and item.instance.Parent == workspace then
					masihAda += 1
				end
			end
			if masihAda == 0 then
				break
			end
			task.wait(0.15)
		until (os.clock() - vanishStart) > 12

		local maxVisit = math.min(#RecordedReveals, MAX_REVEALS)
		for idx = 1, maxVisit do
			if not isActive(token) then return end
			local item = RecordedReveals[idx]
			onStatusChange(string.format("Teleporting (%d/%d)...", idx, maxVisit), "TP Reveal")
			teleportTo(item.cframe)
			task.wait(0.35)
		end
	end

	onStatusChange("Waiting...", "Wait Dig")
	local digWaitStart = os.clock()
	repeat
		if not isActive(token) then return end
		if #getWorkspaceByName("Dig Spot") > 0 then
			break
		end
		task.wait(0.2)
	until (os.clock() - digWaitStart) > 6

	while isActive(token) do
		if #getWorkspaceByName("Dig Spot") > 0 then
			processDigSpots(token)
			if not isActive(token) then return end
		end

		local countdown = 5
		local foundDigDuringCountdown = false

		while isActive(token) and countdown > 0 do
			if #getWorkspaceByName("Dig Spot") > 0 then
				foundDigDuringCountdown = true
				onStatusChange("Digging...", "Dig")
				task.wait(0.2)
				break
			end
			onStatusChange(string.format("Portal in %ds...", countdown), "Countdown")
			local stepStart = os.clock()
			while isActive(token) and (os.clock() - stepStart) < 1 do
				if #getWorkspaceByName("Dig Spot") > 0 then
					foundDigDuringCountdown = true
					break
				end
				task.wait(0.1)
			end
			if foundDigDuringCountdown then
				onStatusChange("Digging...", "Dig")
				task.wait(0.15)
				break
			end
			countdown -= 1
		end

		if not isActive(token) then return end
		if not foundDigDuringCountdown and #getWorkspaceByName("Dig Spot") == 0 then
			break
		end
	end

	onStatusChange("Going to portal...", "Portal")
	local portalObj, portalPrompt = getPortalObjects()
	local portalCF = getPivotCFrame(portalObj) or (portalPrompt and (getPivotCFrame(portalPrompt.Parent) or getPivotCFrame(portalPrompt)))
	if portalCF then
		teleportTo(portalCF)
		task.wait(0.25)
	end
	if portalPrompt then
		firePrompt(portalPrompt)
	end
	task.wait(0.5)

	if isActive(token) then
		deliverToSmelter()
		onStatusChange("Waiting 18s...", "Wait")
		local waitStart = os.clock()
		while isActive(token) do
			local remaining = 18 - (os.clock() - waitStart)
			if remaining <= 0 then break end
			onStatusChange(string.format("Waiting %ds...", math.floor(remaining)), "Wait")
			task.wait(0.5)
		end
		if isActive(token) then
			teleportToTargetPlace()
			task.wait(5)
		end
	end
end

local function setAutoPlay(enabled)
	AutoRunning = enabled
	RunToken += 1
	local activeToken = RunToken

	if not enabled then
		onStatusChange("Idle", "-")
		return
	end

	onStatusChange("Auto started", "Init")
	task.spawn(function()
		while isActive(activeToken) do
			local ok, err = pcall(function()
				runAutoPlayCycle(activeToken)
			end)
			if not ok then
				onStatusChange("Error: " .. tostring(err), "Error")
				task.wait(1)
			end
		end
		if activeToken == RunToken and not AutoRunning then
			onStatusChange("Idle", "-")
		end
	end)
end

